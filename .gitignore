# Godot
.godot/
*.import
.import/

# Byggda paket
build/
*.pck
*.zip
__pycache__/
*.pyc

# Kontaktkartor från generatorerna: provbilder som går att köra om, hör inte till spelet
*_kontaktkarta.png
# Felsmasker från samma körningar (provbilder som visar var en platta fallerar) — de låg kvar i
# assets/ och importerades av Godot som spelgrafik, vilket de inte är.
*.fel.png

# Alex egna bildmaterial (41 MB JPEG): källmaterial, inte speldata. Verktygets källor kopieras
# till research/ så att körningen kan upprepas utan mappen. Undantagen är de ark som spelets
# nuvarande figurer och hjältar är klippta ur — de följer med som backup (ca 14 MB).
game/images/*
!game/images/heroes.jpeg
!game/images/Gemini_Generated_Image_hg2q75hg2q75hg2q.jpeg
!game/images/Gemini_Generated_Image_bnl3m9bnl3m9bnl3.jpeg
!game/images/Gemini_Generated_Image_npicy9npicy9npic.jpeg
!game/images/Gemini_Generated_Image_94096b94096b9409.jpeg
build-linux/

# Städning efter gren-mergerna (M113/M116/M117).
# Närbilden av stenplattan skrivs av `tools/gen_bar_sten.py` vid VARJE körning (även `--check`, som
# sviten kör) och läses av ingenting — den är ett mellansteg i generatorn, inte en tillgång, så den
# hör inte i git. Att ha den som okänd fil gör dessutom varje `git status` efter en svitkörning grumlig.
game/assets/ui/_bar_sten_narbild.png

# Världskarteditorns ATOMISKA skrivning (M121), samma skäl. `karta.json.bak` läggs åt sidan av
# `Karta.skriv` vid den FÖRSTA sparningen och städas ALDRIG bort — den är Alex' handbackning av
# originalet och ska finnas kvar på disk, men den är ingen tillgång och hör inte i git. `*.tmp` är
# halvfärdiga skrivningen (temp-filen som byter namn till målet): den ligger bara kvar efter en
# avbruten skrivning, och just därför ska den inte kunna råka bli en committad fil.
game/data/karta.json.bak
*.tmp

# 32rogues (Seth Boyles) ANVÄNDS i spelet och tackas i krediteringen (CREDITS.md + TACK TILL i
# startmenyn), men paketets licens säger uttryckligen "You may not redistribute or resell it."
# Repot är publikt, så att lägga filerna här vore vidaredistribution — användning i spelet är tillåtet,
# vidaredistribution är det inte, och det är två olika saker. Mappen står här så att paketet inte kan
# committas av misstag om någon lägger det lokalt under assets för att arbeta med det.
game/assets/tredjepart/32rogues/

# Ljuden utan licensfil (Alex 14/10). De två paketen kom utan license.txt/README — bara en KÄLLA.txt
# som säger att de är hämtade från itch.io under en free-licens. Den muntliga uppgiften räcker för att
# ANVÄNDA ljuden i spelet, men den är inget bevis för att FÅ PUBLICERA dem: repot är publikt, så att
# lägga filerna här vore vidaredistribution utan belagd rätt. Spelet använder dem, filerna ligger kvar
# lokalt på disk, och mapparna står här så att de inte kan committas av misstag — samma skäl och samma
# form som 32rogues-regeln ovan (CREDITS.md förklarar varje paket).
game/assets/tredjepart/ljud_horror/
game/assets/tredjepart/ljud_400/

# Effektpaketet unTied: `PNG/` är exakt samma animationer som `spritesheet/`, men utlagda som enskilda
# rambilder. Paketets egen README säger att man väljer den ena ELLER den andra formen, och Godot
# använder arken + spritesheet.txt (den bär rutan för varje ram) — 408 ark är 5,5 MB mot 45 MB
# ramdumpar. Dubletten står därför utanför git; både arken och ramarna ligger kvar på disk.
game/assets/tredjepart/untied_super_pixel_effects/PNG/

# 1244 item-ikoner (16x16): ingen licensfil, bara KÄLLA.txt — används i spelet, publiceras inte.
game/assets/tredjepart/ikoner_1244/

# Arbetsfilen Alex och jag jobbar mot: en .blend är 7 MB binär och hör inte i git.
# Spelet läser game/assets/by/byn.glb; den här filen är källan vi redigerar.
assets/*.blend*
# Äldre versioner av samma fil (flyttade hit 19/10 från Downloads/Pictures/Documents, 18 filer, 100 MB).
assets/arkiv/
assets/**/*.blend*

# jobb/ är min arbetsyta i projektet: skripten och README hör i git, bilderna och ögonblicksbilderna inte.
jobb/bilder/
jobb/snapshots/

# assets/ är nu arbetsytan för byn: källkonsten (5 JPEG, 9 MB), arkivet med 18 äldre .blend (100 MB)
# och arbetsfilen. Samma skäl som raderna ovan — källmaterial och binärer hör inte i ett publikt repo.
/assets/
