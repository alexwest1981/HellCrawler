; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/icon="res://assets/ui/ikon.png"
boot_splash/bg_color=Color(0.039, 0.035, 0.055, 1)
boot_splash/show_image=true
boot_splash/image="res://assets/ui/splash.png"
boot_splash/fullsize=true
boot_splash/use_filter=true

config/name="HellCrawler"
config/version="0.3.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.8")

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1920
window/size/window_height_override=1080

[rendering]

textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
